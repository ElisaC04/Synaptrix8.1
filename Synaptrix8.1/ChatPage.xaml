<Page
    x:Class="Synaptrix8._1.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Synaptrix8._1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,40,16,16">
            <TextBlock x:Name="RoomNameTitle" 
                       Text="ROOM NAME" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="{ThemeResource PhoneAccentBrush}"/>
        </StackPanel>

        <ListView x:Name="MessagesListView" 
                  Grid.Row="1" 
                  Margin="16,0,16,0"
                  ShowsScrollingPlaceholders="False">
            <ListView.Header>
                <Button x:Name="LoadOlderButton" 
                        Content="Load Older Messages" 
                        HorizontalAlignment="Stretch" 
                        Margin="12" 
                        Click="OnLoadOlderClicked"/>
            </ListView.Header>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,16" HorizontalAlignment="{Binding BubbleAlignment}">

                        <TextBlock Text="{Binding SenderName}" 
                                   FontSize="14" 
                                   Foreground="Gray" 
                                   Margin="0,0,0,4"
                                   Visibility="{Binding NameVisibility}"/>

                        <StackPanel Margin="0,0,0,16" HorizontalAlignment="{Binding BubbleAlignment}" Holding="OnMessageHolding">

                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Reply" Click="OnReplyMenuClicked"/>
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>

                            <TextBlock Text="{Binding Sender}" 
                                       Visibility="{Binding NameVisibility}" 
                                       Foreground="LightGray" 
                                       FontSize="14" 
                                       Margin="4,0,0,4" />

                            <Border Background="{Binding BubbleColor}" 
                                    CornerRadius="8" 
                                    Padding="12,8,12,8"
                                    MaxWidth="300">

                                <StackPanel>
                                    <Border Visibility="{Binding ReplyVisibility}"
                                            Background="#33000000"
                                            BorderBrush="White"
                                            BorderThickness="2,0,0,0"
                                            Margin="0,0,0,8"
                                            Padding="8,4,8,4"
                                            CornerRadius="0,4,4,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ReplySender}" FontWeight="Bold" FontSize="12" Foreground="LightGray" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ReplyBody}" FontSize="12" Foreground="LightGray" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Image Source="{Binding ImageUrl}" 
                                           Visibility="{Binding ImageVisibility}" 
                                           MaxWidth="260" 
                                           MaxHeight="260" 
                                           Stretch="Uniform" 
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,8" />
                                    <Button Content="⬇️ Download Media" 
                                            Visibility="{Binding DownloadButtonVisibility}"
                                            Tag="{Binding RawMediaUrl}"
                                            Click="OnDownloadAttachmentClicked"
                                            Background="Transparent"
                                            BorderThickness="1"
                                            BorderBrush="White"
                                            Foreground="White"
                                            Margin="0,0,0,5"
                                            HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Body}" 
                                               FontSize="16" 
                                               TextWrapping="Wrap" 
                                               Foreground="White"
                                               Visibility="{Binding TextVisibility}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Time}" 
                                   FontSize="12" 
                                   Foreground="Gray" 
                                   HorizontalAlignment="{Binding BubbleAlignment}" 
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding ReadReceiptsText}" 
                                   FontSize="11" 
                                   Foreground="{ThemeResource PhoneAccentBrush}" 
                                   HorizontalAlignment="{Binding BubbleAlignment}" 
                                   Visibility="{Binding ReadReceiptVisibility}" 
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Border x:Name="TypingIndicatorBorder" 
                Grid.Row="1" 
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Left" 
                Background="{ThemeResource PhoneAccentBrush}" 
                CornerRadius="12" 
                Margin="16,0,0,8" 
                Padding="12,4,12,4" 
                Visibility="Collapsed"
                Opacity="0.8">
            <TextBlock x:Name="TypingIndicatorText" 
                       Text="Someone is typing..." 
                       FontSize="12" 
                       FontStyle="Italic" 
                       Foreground="White"/>
        </Border>
        <StackPanel Grid.Row="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <Border x:Name="ReplyPreviewBox" Background="#33FFFFFF" Padding="12,8,12,8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="ReplyPreviewSender" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource PhoneAccentBrush}"/>
                        <TextBlock x:Name="ReplyPreviewBody" FontSize="12" Foreground="LightGray" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" FontSize="16" Padding="8,4,8,4" MinWidth="0" MinHeight="0" BorderThickness="0" Background="Transparent" Click="OnCancelReplyClicked"/>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AttachMenuButton" Grid.Column="0" Content="+" FontSize="24" MinWidth="40" MinHeight="40" Padding="0,0,0,4" VerticalAlignment="Bottom" Margin="8,8,0,12">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="📷 Gallery / Camera" Click="OnMediaMenuClicked"/>
                            <MenuFlyoutItem Text="📁 Document" Click="OnDocumentMenuClicked"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <TextBox x:Name="MessageInputBox" Grid.Column="1" Margin="8,8,8,8" PlaceholderText="type a message..." TextWrapping="Wrap" MaxHeight="120" AcceptsReturn="True" VerticalAlignment="Bottom"/>

                <Button x:Name="SendButton" Grid.Column="2" Content="Send" Margin="0,8,8,12" VerticalAlignment="Bottom" Click="OnSendClicked"/>
            </Grid>
        </StackPanel>

        <ProgressBar x:Name="LoadingProgress" 
                     Grid.Row="1" 
                     VerticalAlignment="Top" 
                     IsIndeterminate="True" 
                     Visibility="Collapsed"/>
    </Grid>
</Page>